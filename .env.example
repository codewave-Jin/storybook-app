DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
INTERNAL_API_KEY="replace-with-a-random-internal-key"
# GPT image worker. Cron sends Authorization: Bearer CRON_SECRET.
GPT_IMAGE_WORKER_SECRET="replace-with-a-random-worker-secret"
CRON_SECRET="replace-with-the-same-or-another-secret"
GPT_IMAGE_CONCURRENCY="3"
GPT_IMAGE_INPUT_IMAGES_PER_MIN="15"
GPT_IMAGE_WORKER_STOP_BEFORE_MS="90000"
# Scripts/CLI that call GPT directly can set this to skip the queue.
# GPT_IMAGE_QUEUE_BYPASS="1"
BLOB_READ_WRITE_TOKEN="vercel-blob-token-for-production"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
# Set true only for local/dev without OpenAI/Comfy. Production must use false or unset.
COMFY_MOCK="false"
OPENAI_API_KEY="replace-with-your-openai-api-key"
# GPT image quality for illustrations and style transfer: low | medium | high
IMAGE_QUALITY="medium"
COMFY_SERVER_URL="http://localhost:8000"
