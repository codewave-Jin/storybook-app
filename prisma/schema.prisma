generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String?
  name               String
  isAdmin            Boolean  @default(false)
  characterSlotLimit Int      @default(5)
  createdAt          DateTime @default(now())

  characters        Character[]
  tokenBalance      TokenBalance?
  tokenTransactions TokenTransaction[]
  orders            StorybookOrder[]
  stickerOrders     StickerOrder[]
  reviews           Review[]
  orderStatusLogs   OrderStatusLog[]
}

model TokenBalance {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  freeBalance       Int       @default(0)
  paidBalance       Int       @default(0)
  lastFreeGrantDate DateTime?
}

model TokenTransaction {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  amount    Int
  type      TokenTransactionType
  createdAt DateTime              @default(now())
}

enum TokenTransactionType {
  DAILY_FREE
  CHARACTER_GENERATION
  PURCHASE
}

model Character {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  label              String
  gender             Gender
  originalPhotoPath  String
  generatedImagePath String?
  seed               BigInt?
  status             CharacterStatus  @default(PENDING)
  progressPercent    Int              @default(0)
  progressLabel      String?
  createdAt          DateTime         @default(now())

  stickerOrders      StickerOrder[]
  characterAssets    CharacterAsset[]
}

enum Gender {
  MALE
  FEMALE
}

enum CharacterStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Reusable two-stage character sheet: ComfyUI portrait, then GPT style transfer.
/// Source photo is Character.originalPhotoPath via characterId.
model CharacterAsset {
  id             String    @id @default(cuid())
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  artStyleId     String
  artStyle       ArtStyle  @relation(fields: [artStyleId], references: [id])
  /// ComfyUI PuLID output
  rawPortraitUrl String?
  /// GPT style-converted character sheet
  styledImageUrl String?
  /// PENDING | COMFY_GENERATING | STYLING | READY | FAILED
  status         String    @default("PENDING")
  retryCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders StorybookOrder[]

  @@index([characterId, artStyleId])
  @@index([artStyleId])
}

enum TemplateCategory {
  FUN
  EDUCATIONAL
  DREAM_JOB
}

model StorybookTemplate {
  id           String           @id @default(cuid())
  title        String
  description  String?
  category     TemplateCategory @default(FUN)
  /// Legacy JSON question fields; prefer TemplateQuestion going forward.
  customFields Json
  topicPresets Json             @default("[]")
  orders       StorybookOrder[]
  pageTemplates PageTemplate[]
  questions    TemplateQuestion[]
  artStyles    TemplateArtStyle[]
}

model PageTemplate {
  id                  String               @id @default(cuid())
  storybookTemplateId String
  storybookTemplate   StorybookTemplate    @relation(fields: [storybookTemplateId], references: [id], onDelete: Cascade)
  pageNumber          Int
  pageType            IllustrationPageType @default(PAGE)
  promptTemplate      String
  characterSlots      Int                  @default(1)
  /// Optional expression direction for pages that should change the face.
  expressionHint      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([storybookTemplateId, pageNumber])
  @@index([storybookTemplateId])
}

model TemplateQuestion {
  id                  String            @id @default(cuid())
  storybookTemplateId String
  storybookTemplate   StorybookTemplate @relation(fields: [storybookTemplateId], references: [id], onDelete: Cascade)
  key                 String
  label               String
  answerType          String            @default("text")
  placeholder         String?
  required            Boolean           @default(true)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([storybookTemplateId, key])
  @@index([storybookTemplateId, sortOrder])
}

model ArtStyle {
  id                 String   @id @default(cuid())
  key                String   @unique
  label              String
  /// Supabase Storage public URL for style reference image
  referenceImageUrl  String?
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  templates       TemplateArtStyle[]
  orders          StorybookOrder[]
  characterAssets CharacterAsset[]
}

model TemplateArtStyle {
  storybookTemplateId String
  artStyleId          String
  storybookTemplate   StorybookTemplate @relation(fields: [storybookTemplateId], references: [id], onDelete: Cascade)
  artStyle            ArtStyle          @relation(fields: [artStyleId], references: [id], onDelete: Cascade)
  sortOrder           Int               @default(0)

  @@id([storybookTemplateId, artStyleId])
  @@index([artStyleId])
}

model StorybookOrder {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id])
  templateId           String
  template             StorybookTemplate @relation(fields: [templateId], references: [id])
  selectedCharacterIds Json
  customInputValues    Json
  artStyleId           String?
  artStyle             ArtStyle?        @relation(fields: [artStyleId], references: [id], onDelete: SetNull)
  characterAssetId     String?
  characterAsset       CharacterAsset?  @relation(fields: [characterAssetId], references: [id], onDelete: SetNull)
  paymentStatus        PaymentStatus    @default(PENDING)
  productionStatus     ProductionStatus @default(WAITING)
  fulfillmentStatus    FulfillmentStatus @default(PREPARING)
  expectedDeliveryAt   DateTime?
  shippingCarrier      String?
  trackingNumber       String?
  previewGeneratedAt   DateTime?
  createdAt            DateTime         @default(now())

  illustrations   Illustration[]
  photoAlbumPages PhotoAlbumPage[]
  review          Review?
  statusLogs      OrderStatusLog[]

  @@index([artStyleId])
  @@index([characterAssetId])
}

model GenerationEvent {
  id        String   @id @default(cuid())
  kind      String
  entityId  String   @map("entity_id")
  orderId   String?  @map("order_id")
  userId    String?  @map("user_id")
  step      String
  message   String?
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityId, createdAt])
  @@index([orderId, createdAt])
  @@index([kind, createdAt])
  @@map("generation_events")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ProductionStatus {
  WAITING
  ILLUSTRATING
  UPSCALING
  COMPLETED
}

enum FulfillmentStatus {
  PREPARING
  PRINTING
  PRINTED
  SHIPPING
  DELIVERED
}

model OrderStatusLog {
  id              String             @id @default(cuid())
  orderId         String             @map("order_id")
  order           StorybookOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      FulfillmentStatus? @map("from_status")
  toStatus        FulfillmentStatus  @map("to_status")
  carrier         String?
  trackingNumber  String?            @map("tracking_number")
  actorId         String?            @map("actor_id")
  actor           User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

model Illustration {
  id                   String              @id @default(cuid())
  orderId              String
  order                StorybookOrder      @relation(fields: [orderId], references: [id])
  pageNumber           Int
  prompt               String
  selectedCharacterIds Json                @default("[]")
  imagePath            String?
  sceneImagePath       String?
  upscaledImagePath    String?
  seed                 BigInt?
  status               IllustrationStatus  @default(IDLE)
  progressPercent      Int                 @default(0)
  progressLabel        String?
  pageType             IllustrationPageType @default(PAGE)
  isAutoGenerated      Boolean             @default(false)
  errorReason          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt @default(now())
}

enum IllustrationStatus {
  IDLE
  PROCESSING
  COMPLETED
  FAILED
}

enum IllustrationPageType {
  COVER
  PAGE
}

enum StickerPreviewStatus {
  IDLE
  PROCESSING
  COMPLETED
  FAILED
}

model PhotoAlbumPage {
  id         String         @id @default(cuid())
  orderId    String
  order      StorybookOrder @relation(fields: [orderId], references: [id])
  layoutId   String
  photoPaths Json
}

model StickerTemplate {
  id                       String         @id @default(cuid())
  key                      String         @unique
  label                    String
  thumbnailPath            String?
  promptModifier           String
  /// Circular sticker frame / design reference (uploaded later by admin)
  designReferenceImageUrl  String?
  createdAt                DateTime       @default(now())
  orders                   StickerOrder[]
}

enum StickerBorderCategory {
  NONE
  BASIC
  FLOWER
  LINE
  SPECIAL
}

model StickerBorder {
  id                 String                @id @default(cuid())
  key                String                @unique
  label              String
  imageUrl           String
  thumbnailPath      String?
  category           StickerBorderCategory
  /// Fraction of the border's shorter side. test-composite: 0.48
  characterSizeRatio Float                 @default(0.48)
  /// Offset from center, as a fraction of border width. +right
  offsetXRatio       Float                 @default(0)
  /// Offset from center, as a fraction of border height. +down
  offsetYRatio       Float                 @default(0)
  sortOrder          Int                   @default(0)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  orders StickerOrder[]

  @@index([category, sortOrder])
}

model StickerCostume {
  id                String   @id @default(cuid())
  key               String   @unique
  label             String
  /// Unused for now; kept for a possible future costume reference image
  referenceImageUrl String?
  /// Korean noun phrase inserted into the sticker prompt, e.g. "나비 날개와 더듬이가 있는 코스튬을"
  promptHint        String   @default("")
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders StickerOrder[]
}

model StickerPhrasePreset {
  id   String @id @default(cuid())
  text String
}

model StickerSizeOption {
  id            String         @id @default(cuid())
  label         String
  widthMm       Int
  heightMm      Int
  quantityPerA4 Int
  orders        StickerOrder[]
}

model StickerOrder {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  characterId      String
  character        Character         @relation(fields: [characterId], references: [id])
  templateId       String?
  template         StickerTemplate?  @relation(fields: [templateId], references: [id])
  borderId         String?
  border           StickerBorder?    @relation(fields: [borderId], references: [id], onDelete: Restrict)
  costumeId        String?
  costume          StickerCostume?   @relation(fields: [costumeId], references: [id], onDelete: SetNull)
  customCostumeHint String          @default("")
  phrase           String
  sizeOptionId     String
  sizeOption       StickerSizeOption @relation(fields: [sizeOptionId], references: [id])
  quantity         Int
  previewImagePath String?
  finalImagePath   String?
  /// Sharp composite of border + ComfyUI original character, used as the GPT input.
  compositeImagePath String?
  previewStatus    StickerPreviewStatus @default(IDLE)
  errorReason      String?
  paymentStatus    PaymentStatus     @default(PENDING)
  productionStatus ProductionStatus  @default(WAITING)
  createdAt        DateTime          @default(now())
  review           Review?

  @@index([costumeId])
  @@index([borderId])
}

model Review {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id])
  storybookOrderId String?  @unique @map("storybook_order_id")
  storybookOrder   StorybookOrder? @relation(fields: [storybookOrderId], references: [id])
  stickerOrderId   String?  @unique @map("sticker_order_id")
  stickerOrder     StickerOrder? @relation(fields: [stickerOrderId], references: [id])
  productId        String?  @map("product_id")
  rating           Int      @db.SmallInt
  content          String
  isFeatured       Boolean  @default(false) @map("is_featured")
  featuredAt       DateTime? @map("featured_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  images           ReviewImage[]

  @@index([userId, createdAt])
  @@index([isFeatured, featuredAt])
  @@map("reviews")
}

model ReviewImage {
  id        String @id @default(cuid())
  reviewId  String @map("review_id")
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order") @db.SmallInt

  @@index([reviewId])
  @@map("review_images")
}

/// Global GPT image queue. Worker claims with SKIP LOCKED.
/// kind: STYLE_CHARACTER | ILLUSTRATION | STICKER
/// status: QUEUED | RUNNING | SUCCEEDED | FAILED
/// priority: style 200, cover 100, body 100-N, sticker/admin 50
model GptImageJob {
  id          String    @id @default(cuid())
  kind        String
  targetId    String
  payload     Json
  status      String    @default("QUEUED")
  inputImages Int
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  usages GptImageUsage[]

  @@index([status, runAfter, priority, createdAt])
  @@index([kind, targetId, status])
}

model GptImageUsage {
  id          String      @id @default(cuid())
  jobId       String
  job         GptImageJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inputImages Int
  startedAt   DateTime    @default(now())

  @@index([startedAt])
  @@index([jobId])
}
